[Unit]
Description=letmeknow serve: membership service and relay
After=network-online.target
Wants=network-online.target

[Service]
User=letmeknow
ExecStart=/usr/local/bin/letmeknow serve --domain @DOMAIN@ --state /var/lib/letmeknow
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=RUST_LOG=info
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
