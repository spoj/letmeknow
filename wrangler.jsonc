{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letmeknow",
  "main": "src/index.ts",
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.client.js"],
      "fallthrough": true
    }
  ],
  "account_id": "7a70f73ca6868c580737f00a3ddbf79b",
  "compatibility_date": "2025-03-01",
  "workers_dev": true,
  "routes": [
    "letmeknow.dev/*",
    "*.letmeknow.dev/*"
  ],
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "letmeknow-uploads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "Session"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Question"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["Question"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["Session"]
    }
  ]
}
