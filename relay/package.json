{
  "name": "letmeknow-relay",
  "private": true,
  "type": "module",
  "scripts": {
    "web": "npm --prefix ../web ci && node ../web/build.mjs",
    "dev": "npm run web && wrangler dev",
    "deploy": "npm run web && wrangler deploy",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run check && vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/node": "^22.15.17",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
